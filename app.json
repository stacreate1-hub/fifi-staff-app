{
  "expo": {
    "name": "fifi-staff-app",
    "slug": "fifi-staff-app",
    "version": "1.0.0",
    "scheme": "fifistaff",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fificapturestudio.staffapp"
    },
    "android": {
      "package": "com.fificapturestudio.staffapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec4fc1ab-2442-423d-bc9f-060a14b08cd4"
      }
    },
    "owner": "stacreates-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ec4fc1ab-2442-423d-bc9f-060a14b08cd4"
    }
  }
}
